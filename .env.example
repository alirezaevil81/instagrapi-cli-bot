# ==============================================================================
# Instagram CLI Bot Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Instagram API Request Delay (cl.delay_range)
# Default API request delay range [min_seconds, max_seconds] (instagrapi cl.delay_range)
# Applied after authentication to prevent delays during login
# ------------------------------------------------------------------------------
DELAY_RANGE_MIN=3
DELAY_RANGE_MAX=7

# ------------------------------------------------------------------------------
# 2. Instagram Account Credentials (Optional)
# Credentials for fast or automatic login (prompted interactively if left blank)
# ------------------------------------------------------------------------------
IG_USERNAME=
IG_PASSWORD=
IG_SESSIONID=
IG_AUTO_LOGIN=false

# ------------------------------------------------------------------------------
# 3. Proxy Configuration (Optional)
# Configure an HTTP/SOCKS proxy if needed (e.g., http://127.0.0.1:8080 or socks5://127.0.0.1:1080)
# ------------------------------------------------------------------------------
IG_PROXY=

# ------------------------------------------------------------------------------
# 4. Paths & Storage (Optional)
# Directories and configuration file paths
# ------------------------------------------------------------------------------
STORAGE_DIR=storage
COMMENTS_FILE_PATH=comments.json
COMMENTS_TEMPLATE_PATH=comments.example.json
